# Боевой сайт на Timeweb (Apache). Файлы сборки с хешем в имени не меняются: кэш на год
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|png|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

# Один адрес вместо двух: с www отправляем на основной, поиск не дробит сайт на дубли
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# Настройки бота лежат рядом с сайтом: закрываем файл от прямых запросов
<Files "lead-config.php">
  Require all denied
</Files>

AddDefaultCharset utf-8
ErrorDocument 404 /
